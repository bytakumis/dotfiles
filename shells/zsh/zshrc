# ============
# __ worktreeの検索
# ------------
function _fworktree() {
  git worktree list --porcelain \
    | awk '
        function add() {
          if (path != "") {
            paths[++n] = path
            branches[n] = branch

            if (length(branch) > max_width) {
              max_width = length(branch)
            }
          }
        }

        /^worktree / {
          add()

          path = substr($0, 10)
          branch = "(detached)"
        }

        /^branch / {
          branch = $0
          sub(/^branch refs\/heads\//, "", branch)
        }

        END {
          add()

          for (i = 1; i <= n; i++) {
            # 1列目: cd用の実パス
            # 2列目: fzfで表示する整形済み文字列
            printf "%s\t%-*s  %s\n",
              paths[i],
              max_width,
              branches[i],
              paths[i]
          }
        }
      ' \
    | fzf \
        --delimiter=$'\t' \
        --with-nth=2 \
        --prompt='worktree> ' \
        --preview 'git -C {1} status --short --branch'
}

# ============
# worktreeを一覧化して、fzfで選択したworktreeに移動する
# ------------
function gw() {
  local selected=$(_fworktree) || return
  local dir="${selected%%$'\t'*}"
  cd "$dir"
}

# ============
# __ branchの検索
# ------------
function _fbranch() {
  git branch \
    --format='%(refname:short)' \
    --sort=-committerdate \
    | fzf \
        --prompt='branch> ' \
        --preview 'git log --color=always --oneline --decorate -20 {}'
}

# ============
# fzfでbranchを選択し、そのbranchに移動する
# ------------
unalias gb 2>/dev/null
function gb() {
  local branch=$(_fbranch) || return
  git switch "$branch"
}

# ============
# __ ファイルの検索
# ------------
function _ffile() {
  fd --type f "$1" . \
    | fzf --preview 'bat --color=always {} 2>/dev/null || sed -n "1,200p" {}'
}

# ============
# 現在のdir配下からfzfでファイル名を検索し、対象をvimで開く
# ------------
function vimf() {
  local file=$(_ffile "$1") || return
  vim "$file"
}

# ============
# 現在のdir配下からfzfでファイル名を検索し、対象をvimで開く
# ------------
function codef() {
  local file=$(_ffile "$1") || return
  code "$file"
}


# ============
# ~/Repos/ 配下のリポジトリをfzfで検索して移動する
# ------------
function cdr() {
  local repo
  repo=$(
    fd -H -t d '^\.git$' ~/Repos --max-depth 3 |
      sed -e 's#/.git/$##' -e "s#^$HOME/Repos/##" |
      fzf --height=40% --reverse
  )
  [[ -n "$repo" ]] && cd "$HOME/Repos/$repo"
}

# ============
# __ ファイル検索用
# ------------
function _fsearch() {
  rg --line-number --no-heading --color=always "$1" . \
    | fzf --ansi \
          --delimiter=: \
          --preview 'bat --color=always --highlight-line {2} {1}'
}

# ============
# 現在のdir配下からfzfでファイルの中身を検索し、対象をvimで開く
# ------------
function vims() {
  local selected=$(_fsearch "$1") || return

  local file="${selected%%:*}"
  local rest="${selected#*:}"
  local line="${rest%%:*}"

  vim "+${line}" "$file"
}

# ============
# 現在のdir配下からfzfでファイルの中身を検索し、対象をエディターで開く
# ------------
function codes() {
  local selected=$(_fsearch "$1") || return

  local file="${selected%%:*}"
  local rest="${selected#*:}"
  local line="${rest%%:*}"

  code --goto "${file}:${line}"
}

gwc() {
  local dir
  dir=$(git worktree list | fzf | awk '{print $1}')
  [[ -n "$dir" ]] && cd "$dir"
}

export ENHANCD_DOT_ARG='...'

# 現在のディレクトリでpecoを使用してcdする
cd_by_peco_on_current_dir() {
  local selected_dir=$(fd . -t d -H | peco)
  if [ -n "$selected_dir" ]; then
    cd "$selected_dir"
    echo "cd $selected_dir"
    zle reset-prompt
  fi
}
zle -N cd_by_peco_on_current_dir

# ルートディレクトリからpecoを使用してcdする
cd_by_peco_on_root_dir() {
  local home_dir=$(realpath ~)
  local selected_dir=$(fd . "$home_dir" -t d -H | peco)
  if [ -n "$selected_dir" ]; then
    BUFFER="cd $selected_dir"
    zle accept-line
  fi
}
zle -N cd_by_peco_on_root_dir
bindkey '^P' cd_by_peco_on_root_dir

# 現在のディレクトリでpecoを使用してvimを開く
vim_by_peco_on_current_dir() {
  local selected_file=$(fd . -t f -H | peco)
  if [ -n "$selected_file" ]; then
    vim "$selected_file"
    echo "vim $selected_file"
    zle reset-prompt
  fi
}
zle -N vim_by_peco_on_current_dir

# ルートディレクトリからpecoを使用してvimを開く
vim_by_peco_on_root_dir() {
  local home_dir=$(realpath ~)
  local selected_file=$(fd . "$home_dir" -t f -H | peco)
  if [ -n "$selected_file" ]; then
